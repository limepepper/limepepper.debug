# Audit rules for gnome-keyring-daemon monitoring
# This file is managed by Ansible - do not edit manually

# Monitor execution of gnome-keyring-daemon wrapper
-a always,exit -F arch=b64 -F path={{ gkr_daemon_path }} -F perm=x -k gnome-keyring-exec

# Monitor execution of real gnome-keyring-daemon binary
-a always,exit -F arch=b64 -F path={{ gkr_real_path }} -F perm=x -k gnome-keyring-exec

-a always,exit -F arch=b64 -F path=/usr/bin/gdb -F perm=x -k gnome-keyring-exec

# Exclude SSH user login/logout events
-a never,user -F msgtype=USER_LOGIN -F exe=/usr/libexec/openssh/sshd-session
-a never,user -F msgtype=USER_LOGOUT -F exe=/usr/libexec/openssh/sshd-session
-a never,user -F msgtype=USER_START -F exe=/usr/libexec/openssh/sshd-session
-a never,user -F msgtype=USER_END -F exe=/usr/libexec/openssh/sshd-session

# Exclude SSH crypto key operations
-a never,user -F msgtype=CRYPTO_KEY_USER -F exe=/usr/libexec/openssh/sshd-session

# Exclude SSH connection events
-a never,user -F msgtype=USER_AUTH -F exe=/usr/libexec/openssh/sshd-session

# exclude ALL SSH daemon activity (more aggressive):
# -a never,exit -F exe=/usr/libexec/openssh/sshd-session
# -a never,user -F exe=/usr/libexec/openssh/sshd-session
