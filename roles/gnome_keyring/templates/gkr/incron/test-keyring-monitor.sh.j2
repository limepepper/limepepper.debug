#!/bin/bash
set -eu ; set -o pipefail

# Test script for keyring monitoring
# This script uses secret-tool to interact with the keyring and verify monitoring is working

KEYRING_FILE="/home/fedora/.local/share/keyrings/login.keyring"
LOG_FILE="/opt/gkr-debug/keyring-monitor.log"

echo "Testing keyring monitoring..."

# Check if incrond is running
if ! systemctl is-active --quiet incrond; then
    echo "ERROR: incrond service is not running"
    exit 1
fi

# Check if monitoring script exists
if [[ ! -f "/opt/gkr-debug/bin/gkr-keyring-monitor.sh" ]]; then
    echo "ERROR: Monitoring script not found"
    exit 1
fi

# Use secret-tool to interact with the keyring
echo "Using secret-tool to interact with keyring..."

# Try to store a test secret (this should trigger monitoring)
echo "Storing test secret..."
if secret-tool store --label="test-pass" test-key "regreg" 2>/dev/null; then
    echo "Successfully stored test secret"
else
    echo "Failed to store test secret (may already exist)"
fi

# Try to retrieve the secret to trigger another interaction
echo "Retrieving test secret..."
if secret-tool lookup test-key 2>/dev/null; then
    echo "Successfully retrieved test secret"
else
    echo "Failed to retrieve test secret"
fi

# Wait a moment for the events to be processed
sleep 2

# Check if log file was created and contains entries
if [[ -f "${LOG_FILE}" ]]; then
    echo "Monitoring log file created successfully"
    echo "Recent log entries:"
    tail -5 "${LOG_FILE}"
else
    echo "WARNING: No log file found at ${LOG_FILE}"
fi

# Check if backup was created
BACKUP_COUNT=$(find /opt/gkr-debug/keyring-backups -name "*.modified" 2>/dev/null | wc -l)
echo "Backup files created: ${BACKUP_COUNT}"

# Test the dump-keyring0-format utility
echo "Testing dump-keyring0-format utility..."

# Test with correct password
echo "Testing with correct password..."
cat > /tmp/test-expect-correct.exp << EOF
#!/usr/bin/expect -f
set timeout 30
spawn /opt/gkr-debug/bin/dump-keyring0-format "${KEYRING_FILE}"
expect "Password: "
send "fedora\r"
expect eof
EOF

expect -f /tmp/test-expect-correct.exp > /tmp/test-dump-correct.txt 2> /tmp/test-dump-correct.err
exit_code=$?

# Check for success indicators in the output
if [[ -s /tmp/test-dump-correct.txt ]] && grep -q "display-name=test-dump-password" /tmp/test-dump-correct.txt && grep -q "secret=hello-world" /tmp/test-dump-correct.txt; then
    echo "SUCCESS: dump-keyring0-format worked with correct password"
    echo "Output preview:"
    head -5 /tmp/test-dump-correct.txt
else
    echo "FAILED: dump-keyring0-format failed with correct password"
    echo "Exit code: ${exit_code}"
    echo "Error output:"
    cat /tmp/test-dump-correct.err
    echo "Stdout output:"
    cat /tmp/test-dump-correct.txt
fi

# Test with wrong password
echo "Testing with wrong password..."
cat > /tmp/test-expect-wrong.exp << EOF
#!/usr/bin/expect -f
set timeout 30
spawn /opt/gkr-debug/bin/dump-keyring0-format "${KEYRING_FILE}"
expect "Password: "
send "wrong-password\r"
expect eof
EOF

expect -f /tmp/test-expect-wrong.exp > /tmp/test-dump-wrong.txt 2> /tmp/test-dump-wrong.err
exit_code=$?

# Check for success indicators in the output
if [[ -s /tmp/test-dump-wrong.txt ]] && grep -q "display-name=test-dump-password" /tmp/test-dump-wrong.txt && grep -q "secret=hello-world" /tmp/test-dump-wrong.txt; then
    echo "WARNING: dump-keyring0-format succeeded with wrong password (unexpected)"
    echo "Output preview:"
    head -5 /tmp/test-dump-wrong.txt
else
    echo "EXPECTED: dump-keyring0-format failed with wrong password"
    echo "Exit code: ${exit_code}"
    echo "Error output:"
    cat /tmp/test-dump-wrong.err
    echo "Stdout output:"
    cat /tmp/test-dump-wrong.txt
fi

# Clean up test files
rm -f /tmp/test-dump-correct.txt /tmp/test-dump-correct.err /tmp/test-dump-wrong.txt /tmp/test-dump-wrong.err
rm -f /tmp/test-expect-correct.exp /tmp/test-expect-wrong.exp

echo "Test completed"
