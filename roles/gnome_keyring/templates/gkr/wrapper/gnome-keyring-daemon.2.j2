#!/bin/bash

mkdir -p "${HOME}/.local/log"
echo "keyring-wrapper: PID=$$ called with: $@" >> "${HOME}/.local/log/gkr-wrapper.log"

# Test if gdb script exists and is readable
echo "GDB script file: /opt/gkr-debug/gkr-debug.gdb" >> "${HOME}/.local/log/gkr-wrapper.log"
ls -la /opt/gkr-debug/gkr-debug.gdb >> "${HOME}/.local/log/gkr-wrapper.log" 2>&1
echo "Script readable: $(test -r /opt/gkr-debug/gkr-debug.gdb && echo yes || echo no)" >> "${HOME}/.local/log/gkr-wrapper.log"

# Try running gdb with the script and see what happens
echo "=== GDB OUTPUT START ===" >> "${HOME}/.local/log/gkr-wrapper.log"
/usr/bin/gdb \
  --batch \
  --return-child-result \
  -x "/opt/gkr-debug/gkr-debug.gdb" \
  --args /opt/gkr-debug/bin/gnome-keyring-daemon "$@" >> "${HOME}/.local/log/gkr-wrapper.log" 2>&1
gdb_exit_code=$?
echo "=== GDB OUTPUT END ===" >> "${HOME}/.local/log/gkr-wrapper.log"
echo "GDB exit code: $gdb_exit_code" >> "${HOME}/.local/log/gkr-wrapper.log"

# Fallback to direct execution if gdb failed
if [ $gdb_exit_code -ne 0 ]; then
    echo "GDB failed, falling back to direct execution" >> "${HOME}/.local/log/gkr-wrapper.log"
    exec /opt/gkr-debug/bin/gnome-keyring-daemon "$@"
else
    echo "GDB succeeded" >> "${HOME}/.local/log/gkr-wrapper.log"
    exit $gdb_exit_code
fi