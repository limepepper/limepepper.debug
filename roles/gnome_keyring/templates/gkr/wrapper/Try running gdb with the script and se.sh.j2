# Try running gdb with the script and see what happens
echo "=== GDB OUTPUT START ===" >> "${HOME}/.local/log/gkr-wrapper.log"
/usr/bin/gdb \
  --batch \
  --return-child-result \
  -ex "set logging file ${HOME}/.local/log/gdb.test.$$.txt" \
  -ex "set pagination off" \
  -ex "set breakpoint pending on" \
  -ex "set debuginfod enabled on" \
  -x "/opt/gkr-debug/gkr-debug.gdb" \
  --args /usr/bin/echo "$@" > "${HOME}/.local/log/gdb.test.$$.tmp" 2>&1
gdb_exit_code=$?
echo "=== GDB OUTPUT END ===" >> "${HOME}/.local/log/gkr-wrapper.log"
echo "GDB exit code: $gdb_exit_code" >> "${HOME}/.local/log/gkr-wrapper.log"

# If GDB failed, append the test output to the main log
if [ $gdb_exit_code -ne 0 ]; then
    echo "GDB test failed, appending output to main log:" >> "${HOME}/.local/log/gkr-wrapper.log"
    cat "${HOME}/.local/log/gdb.test.$$.tmp" >> "${HOME}/.local/log/gkr-wrapper.log"
fi

# Clean up temp file
rm -f "${HOME}/.local/log/gdb.test.$$.tmp"